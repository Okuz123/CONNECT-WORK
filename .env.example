# ============================================================
# CONNECT WORK — Environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- Firebase (client) ----
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=connect-work.firebaseapp.com
FIREBASE_PROJECT_ID=connect-work
FIREBASE_STORAGE_BUCKET=connect-work.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef

# ---- Server ----
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_long_random_string

# ---- Firebase Admin (server) ----
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ---- SMS / OTP (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Maps (optional) ----
MAPS_API_KEY=
