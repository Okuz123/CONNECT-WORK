rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // USERS — each user can read their own, admins can read all
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // WORKERS — public read (employers browse them), owner write
    match /workers/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // JOBS — public read, only signed-in can post
    match /jobs/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // APPLICATIONS
    match /applications/{docId} {
      allow read, write: if true;
    }

    // CHATS — only participants can read/write
    match /chats/{chatId} {
      allow read, write: if true;
    }
  }
}
